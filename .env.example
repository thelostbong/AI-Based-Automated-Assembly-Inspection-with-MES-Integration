# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it contains secrets.

# --- Model / data paths ---
WEIGHTS_PATH=/home/<your-username>/testapp/best.onnx
DATA_YAML_PATH=/home/<your-username>/testapp/data.yaml

# --- Camera device paths ---
# Prefer stable /dev/v4l/by-id/... symlinks if available, otherwise /dev/videoN
CAM0=/dev/video0
CAM1=/dev/video2
CAM2=/dev/video4

# --- Inference settings ---
IMG_SIZE=640
CONF_THRESHOLD=0.25

# --- Flask server ---
HOST=0.0.0.0
PORT=5000

# --- Camera capture tuning ---
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=30
FOURCC=MJPG
WARMUP_GRABS=8
MAX_READ_RETRY=30
RETRY_SLEEP_S=0.015
RELEASE_COOLDOWN=0.20
BUFFERSIZE_TRY=1

# --- Station identity ---
STATION_ID=Q-Check-01

# --- Tulip MES instance + auth ---
# Generate your own API key in Tulip under Settings > API Tokens.
# Do NOT reuse a key issued to another teammate.
TULIP_BASE=https://<your-tenant>.tulip.co/api/v3
TULIP_AUTH_HEADER=Basic <your-base64-encoded-api-key-here>

# --- Tulip table ---
TULIP_TABLE_UID=<your-table-uid>

# --- Tulip machine + attributes (optional, if using attribute reporting) ---
MACHINE_ID=<your-machine-id>
UID_ATTRIBUTE_ID=<your-uid-attribute-id>
TABLE_ID_ATTRIBUTE_ID=<your-table-id-attribute-id>
